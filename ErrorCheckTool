<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MD-U2000 Series - Error Code Tracking</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: white;
            padding: 30px;
            text-align: center;
        }

        .header h1 {
            font-size: 2em;
            margin-bottom: 10px;
        }

        .header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .search-container {
            padding: 30px;
            background: #f8f9fa;
            border-bottom: 2px solid #e9ecef;
        }

        .search-box {
            display: flex;
            gap: 15px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .search-input {
            flex: 1;
            min-width: 250px;
            padding: 15px 20px;
            font-size: 16px;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            transition: all 0.3s;
        }

        .search-input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .filter-buttons {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .filter-btn {
            padding: 10px 20px;
            border: 2px solid #dee2e6;
            background: white;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: 600;
        }

        .filter-btn:hover {
            background: #f8f9fa;
        }

        .filter-btn.active {
            background: #667eea;
            color: white;
            border-color: #667eea;
        }

        .stats {
            display: flex;
            gap: 15px;
            justify-content: center;
            font-size: 14px;
            color: #6c757d;
        }

        .stats span {
            background: white;
            padding: 8px 15px;
            border-radius: 6px;
            border: 1px solid #dee2e6;
        }

        .results-container {
            padding: 30px;
            max-height: calc(100vh - 400px);
            overflow-y: auto;
        }

        .error-card {
            background: white;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 15px;
            transition: all 0.3s;
        }

        .error-card:hover {
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            transform: translateY(-2px);
        }

        .error-header {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }

        .error-code {
            background: #667eea;
            color: white;
            padding: 8px 16px;
            border-radius: 6px;
            font-weight: bold;
            font-size: 1.1em;
        }

        .error-card.warning .error-code {
            background: #ffc107;
            color: #000;
        }

        .error-card.terminal .error-code {
            background: #dc3545;
        }

        .error-card.software .error-code {
            background: #28a745;
        }

        .error-name {
            font-size: 1.1em;
            font-weight: 600;
            color: #2c3e50;
            flex: 1;
        }

        .error-type {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.85em;
            font-weight: 600;
        }

        .error-type.error {
            background: #e3f2fd;
            color: #1976d2;
        }

        .error-type.warning {
            background: #fff3cd;
            color: #856404;
        }

        .error-type.terminal {
            background: #f8d7da;
            color: #721c24;
        }

        .error-type.software {
            background: #d4edda;
            color: #155724;
        }

        .error-remedy {
            color: #495057;
            line-height: 1.6;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
            border-left: 4px solid #667eea;
        }

        .error-remedy ul {
            margin-left: 20px;
            margin-top: 10px;
        }

        .error-remedy li {
            margin-bottom: 5px;
        }

        .no-results {
            text-align: center;
            padding: 60px 20px;
            color: #6c757d;
        }

        .no-results svg {
            width: 100px;
            height: 100px;
            margin-bottom: 20px;
            opacity: 0.5;
        }

        .highlight {
            background: yellow;
            padding: 2px 4px;
            border-radius: 3px;
        }

        @media (max-width: 768px) {
            .header h1 {
                font-size: 1.5em;
            }

            .search-box {
                flex-direction: column;
            }

            .filter-buttons {
                justify-content: center;
            }

            .error-header {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        /* Scrollbar styling */
        .results-container::-webkit-scrollbar {
            width: 10px;
        }

        .results-container::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .results-container::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 5px;
        }

        .results-container::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🔧 MD-U2000 Series Error Code Tracking</h1>
            <p>Problems, Causes, and Remedies - Search by Error Code or Description</p>
        </div>

        <div class="search-container">
            <div class="search-box">
                <input 
                    type="text" 
                    class="search-input" 
                    id="searchInput" 
                    placeholder="Search by error code (e.g., E003) or description (e.g., scanner error)..."
                    autofocus
                >
            </div>

            <div class="filter-buttons">
                <button class="filter-btn active" data-filter="all">All Codes</button>
                <button class="filter-btn" data-filter="error">Errors (E)</button>
                <button class="filter-btn" data-filter="warning">Warnings (W)</button>
                <button class="filter-btn" data-filter="terminal">Terminal (T)</button>
                <button class="filter-btn" data-filter="software">Software (S)</button>
            </div>

            <div class="stats">
                <span>Total: <strong id="totalCount">0</strong></span>
                <span>Showing: <strong id="showingCount">0</strong></span>
            </div>
        </div>

        <div class="results-container" id="resultsContainer">
            <!-- Results will be inserted here -->
        </div>
    </div>

    <script>
        // Error code database
        const errorDatabase = [
            // Error Messages (E-codes)
            { code: "E003", name: "Head unit Comm error", type: "error", remedy: "Switch off the power, then reseat the cable between the head unit and controller. Next, restart the device.\n\nIf the problem reoccurs, check if there are broken pins or breaks in the cable. Replace the cable if any problem is found.\n\nNoise may be affecting the device if there is no problem in the cable and the error occurs in a sporadic manner." },
            { code: "E004", name: "Scanner error", type: "error", remedy: "A repair is needed if the error occurs every time the laser starts up because the scanner is not functioning properly.\n\nIf the error occurs during marking, check if it occurs at a lower scan speed.\n\nIf reducing the scan speed resolves this error, use a scan speed that does not cause the error." },
            { code: "E005", name: "Shutter error", type: "error", remedy: "A repair is needed if the error occurs every time the laser starts up because the shutter is not functioning properly.\n\nIf the error is cleared by a restart, the issue may have been temporary.\n\nThere is no problem if the error does not reoccur." },
            { code: "E006", name: "Head version error", type: "error", remedy: "Failed to retrieve the head version information. Alternatively, a head version incompatible with the controller is connected.\n\nUpdate the head and controller to the latest version." },
            { code: "E007", name: "Head unit model error", type: "error", remedy: "A repair is needed because it is highly likely that the memory data in the head unit has been lost.\n\nNoise may be affecting the device if this error occurs." },
            { code: "E008", name: "Controller Version Error", type: "error", remedy: "Upgrade both the head unit and controller versions by following the procedure below.\n\nSelect [Monitoring] - [Version Information] in the ribbon menu, and then run [Version Upgrade]." },
            { code: "E011", name: "Built-in memory card unrecognizable error", type: "error", remedy: "Please contact our branch office closest to you." },
            { code: "E012", name: "Head Unit Data Error", type: "error", remedy: "A repair is needed because the memory data in the head unit has been lost.\n\nNoise may be affecting the device if this error occurs." },
            { code: "E013", name: "Expansion memory-full error", type: "error", remedy: "Disable the [Job pre-expansion] function or reduce the target job range by following the procedure below.\n\nSelect [Settings] - [Controller] - [Expansion Processing] - [Job pre-expansion] in the ribbon menu, and disable the [Job pre-expansion] function." },
            { code: "E014", name: "Mark memory-full error", type: "error", remedy: "The number of active blocks in the job or the number of matrix cells is too large. Address the issue by dividing the job into multiple jobs.\n\nIf the job contains logo data having a large number of lines, this error can be caused even by a single block.\n\nIn such a case, address the issue by splitting the logo and dividing the job into multiple jobs." },
            { code: "E015", name: "No Job error", type: "error", remedy: "There is no active job in the controller slot specified.\n\nTransfer the job to the controller by following the procedure below.\n\nSelect [Settings] - [File Operations] in the ribbon menu, and then transfer the job settings to the controller." },
            { code: "E017", name: "No font file error", type: "error", remedy: "Transfer the required fonts to the controller by following the procedure below.\n\nSelect [Settings] - [Common Data] - [Font] in the ribbon menu, and then register the font to an appropriate font No." },
            { code: "E020", name: "Expansion memory-full error 2", type: "error", remedy: "Delete the unwanted fonts by following the procedure below.\n\nSelect [Settings] - [Common Data] - [Font] in the ribbon menu, and then delete the unwanted font(s).\n\nIf there are no unwanted fonts, address the issue by reducing the character types in the fonts being used.\n\nReduce the character types by following the procedure below.\n\nSelect [TOOLS] - [Font Architect] in the ribbon menu, and open the font currently being used.\n\nSince the [CJK Unified Ideographs] group contains all of the SJIS Kanji characters, you can delete Kanji characters that are not used.\n\nOnce the font has been modified, transfer it to the controller from [Settings] - [File Operations] - [Font] in the ribbon menu." },
            { code: "E022", name: "Over-Area Error", type: "error", remedy: "Check the work position or the setting of XY tracking or Z tracking when the error is due to the correction result of XY tracking or Z tracking.\n\nIf the tracking function is not enabled, check the following.\n\nCheck and modify the job so that the marking data does not extend beyond the marking area.\n\nIf there is no problem with the job, the marking may have gone beyond the marking area due to the position correction and mounting position adjustment.\n\nCheck and modify the position correction and mounting position adjustment values by following the procedure below.\n\n• Select [Settings] - [Controller] - [Basic Setting] - [Focal Distance and Position Correction] in the ribbon menu, and enter an adequate value for each coordinate.\n\n• Select [Settings] - [Job Settings] - [Mounting Position Adjustment] - [Correct the Horizontal Plane] in the ribbon menu, and then enter an adequate value in [Correction amount]." },
            { code: "E023", name: "Scanner Over-Area Error", type: "error", remedy: "If an error occurs during moving marking, reduce the line speed or increase the scan speed.\n\nIf the 'Marking Range Spec.' is set for moving marking, increase the marking range.\n\nIf the error occurs during workflow operation, check that the 'Pre-marking Capture', 'XY tracking', 'Z tracking', and 'Post-marking Capture' are correct." },
            { code: "E024", name: "File verification error", type: "error", remedy: "Prepare the version upgrade data again and run the version upgrade." },
            { code: "E025", name: "Logo file error", type: "error", remedy: "Transfer the required data to the controller by following the procedure below.\n\nSelect [Settings] - [File Operations] in the ribbon menu, and then transfer the required data to the controller." },
            { code: "E026", name: "Custom character file error", type: "error", remedy: "Transfer the required custom character data to the controller by following the procedure below.\n\nSelect [Settings] - [File Operations] in the ribbon menu, and then transfer the required custom character data to the controller." },
            { code: "E027", name: "Encoding Disabled Error", type: "error", remedy: "Check the job barcode and 2D code encoding character settings by following the procedure below.\n\n• Check if the number of character digits is adequate for the set symbol size.\n\n• Check if there are any strings that cannot be input." },
            { code: "E028", name: "Switching Job Unexecutable Error", type: "error", remedy: "Wait until the job is saved." },
            { code: "E029", name: "Scanner error 2", type: "error", remedy: "A repair is needed if the error occurs every time the laser starts up or every time the laser marks because the scanner is not functioning properly.\n\nNoise may be affecting the device if it occurs randomly." },
            { code: "E030", name: "Expiration setting error", type: "error", remedy: "Modify the expiration setting so that the marking data after expiration will be between the year 1900 and 2100." },
            { code: "E031", name: "Restart error", type: "error", remedy: "If AC power to the laser was turned off and on intentionally without using the key switch, the error will clear with an error reset.\n\nIf this was not intentional, install a UPS because it is highly likely that a momentary power loss has occurred." },
            { code: "E032", name: "Logo/custom character enlargement error", type: "error", remedy: "Reduce the size of the block containing the logo or custom character." },
            { code: "E033", name: "Skip cross error", type: "error", remedy: "Reduce the skip cross setting or increase the character size." },
            { code: "E034", name: "Encoding Disabled Error", type: "error", remedy: "Check the job barcode and 2D code encoding character settings.\n\n• Check if the number of character digits is adequate for the set symbol size.\n\n• Check if there are any strings that cannot be input." },
            { code: "E035", name: "Quick change of character expansion error", type: "error", remedy: "Register the character type(s) you wish to change as high speed edit characters.\n\nYou can register a character for high speed editing using the [Register Character for High Speed Editing (IR)] command." },
            { code: "E038", name: "Logo custom character buffer full error", type: "error", remedy: "Disable the [Job pre-expansion] function or reduce the target job range by following the procedure below.\n\nSelect [Settings] - [Controller] - [Expansion Processing] - [Job pre-expansion] in the ribbon menu, and then correct the [Job pre-expansion] function." },
            { code: "E039", name: "Wobble/Scratch incorrect setting error", type: "error", remedy: "Set the scan speed to 3000mm/s or lower in the marking parameters." },
            { code: "E040", name: "Link block error", type: "error", remedy: "Check that the link destination block is set to [Mark]." },
            { code: "E041", name: "3D marking position incorrect range error", type: "error", remedy: "Change the block position on the 3D shape in the block layout to an adequate value." },
            { code: "E042", name: "Marking loss detection error", type: "error", remedy: "Check the settings and wiring of the sensor connected to the marking confirmation input." },
            { code: "E043", name: "Accidental emission detection error", type: "error", remedy: "" },
            { code: "E044", name: "Z Area over error", type: "error", remedy: "Take adequate measures to suppress the target position fluctuation in the Z coordinate direction." },
            { code: "E045", name: "Unregistered barcode error", type: "error", remedy: "Register the barcode to be used in advance by following the procedure below.\n\nSelect [Settings] - [Controller] - [Option] - [Barcode verification] in the ribbon menu, and perform [Register code]." },
            { code: "E046", name: "Warm up setting error", type: "error", remedy: "Transfer the warm up job to No. 1999.\n\nMake sure that the warm up job does not contain the following functions:\n\n'Counter, Moving Marking, 2D Code Reader, Auto Focus, Marking Confirmation, Matrix, Group, Fixed Point While Trigger is on, Pre/Post Marking Capturing, Pre/Post Marking Lens Inspection, XY Tracking, Z Tracking'" },
            { code: "E047", name: "3D Error of size of block", type: "error", remedy: "Review the 3D block parameters." },
            { code: "E048", name: "Z-MAP file error", type: "error", remedy: "Transfer the required Z-MAP data to the controller by following the procedure below.\n\nSelect [Settings] - [File Operations] - [Z-MAP] in the ribbon menu, and then transfer the required Z-MAP data to the controller." },
            { code: "E049", name: "No font error", type: "error", remedy: "Since a custom character without marking lines cannot be used, check the fonts and custom characters and delete any data that does not contain marking lines.\n\nIf the error occurs even if the marking lines are present, the data may be corrupted.\n\nIf this is the case, create the font/custom character data again from scratch." },
            { code: "E050", name: "Marking data generation error", type: "error", remedy: "Set an adequate trigger delay by following the procedure below.\n\nSelect [Settings] - [Job Settings] - [Stationary Marking/Moving Marking] in the ribbon menu, and then enter an adequate value in [Trigger Delay]." },
            { code: "E051", name: "System Error 2", type: "error", remedy: "Please check the following:\n\n• Transfer the job again if a DataMatrix is included.\n\n• If the Wobble setting is included, transfer the job again after setting the overlap rate to a lower value." },
            { code: "E052", name: "System Error 3", type: "error", remedy: "A repair is needed if the problem persists after a restart.\n\nNoise may be affecting the device if this error occurs." },
            { code: "E053", name: "System Error 4", type: "error", remedy: "Internal data may be corrupted if the problem persists even after a restart.\n\nRestore the data using the backup data from before the problem occurred, or transfer all data again." },
            { code: "E054", name: "System Error 5", type: "error", remedy: "If the error persists after a restart, there may be a problem in the processing of external communications.\n\nCheck if external communications from multiple devices are active or if there is any mistake in the communication command.\n\nNoise may be affecting the device if the error occurs in a sporadic manner." },
            { code: "E055", name: "System Error 6", type: "error", remedy: "Internal data may be corrupted if the problem persists even after a restart.\n\nRestore the data using the backup data from before the problem occurred, or transfer all data again." },
            { code: "E056", name: "System Error 7", type: "error", remedy: "A repair is needed if the problem persists after a restart." },
            { code: "E057", name: "System Error 8", type: "error", remedy: "Restart the device and take the necessary measures.\n\nIf the problem occurs in a specific job, transfer the job to the controller again." },
            { code: "E058", name: "System Error 9", type: "error", remedy: "Restart the device and take the necessary measures.\n\nIf this error occurs during a specific job, the problem may be due multiple line settings of a block.\n\nIf a multiple line setting exists, switch to single line setting and check if the error persists." },
            { code: "E059", name: "System Error 10", type: "error", remedy: "Internal data may be corrupted if the problem persists even after a restart.\n\nTransfer the job from the PC to the controller again." },
            { code: "E061", name: "System Error 12", type: "error", remedy: "A repair is needed if the problem persists after a restart." },
            { code: "E062", name: "System Error 13", type: "error", remedy: "Internal data may be corrupted if the problem persists even after a restart.\n\nRestore the data using the backup data from before the problem occurred, or transfer all data again." },
            { code: "E063", name: "System Error 14", type: "error", remedy: "Switch off the power, reseat the cable between the head unit and controller, and then restart the device.\n\nIf the recovery fails, check if there are broken pins or breaks in the cable. Replace the cable if any problem is found.\n\nA repair is needed if there is no problem with the cable." },
            { code: "E066", name: "System Error 17", type: "error", remedy: "Internal data may be corrupted if the problem persists even after a restart.\n\nRestore the data using the backup data from before the problem occurred, or transfer all data again." },
            { code: "E067", name: "System Error 18", type: "error", remedy: "A repair is needed if the problem persists after a restart.\n\nThis error can occur when there is miswiring in the terminal block.\n\nCheck if the same error occurs even after disconnecting all terminal blocks." },
            { code: "E068", name: "System Error 19", type: "error", remedy: "A repair is needed if the problem persists after a restart.\n\nThis error can occur when there is miswiring in the terminal block.\n\nCheck if the same error occurs even after disconnecting all terminal blocks." },
            { code: "E069", name: "System Error 20", type: "error", remedy: "A repair is needed if the problem persists after a restart." },
            { code: "E070", name: "System Error 21", type: "error", remedy: "A repair is needed if the problem persists after a restart." },
            { code: "E071", name: "System Error 22", type: "error", remedy: "A repair is needed if the problem persists after a restart." },
            { code: "E072", name: "System Error 23", type: "error", remedy: "Please contact our branch office closest to you." },
            { code: "E073", name: "System Error 24", type: "error", remedy: "A repair is needed if the problem persists after a restart." },
            { code: "E074", name: "System Error 25", type: "error", remedy: "A repair is needed if the problem persists after a restart." },
            { code: "E075", name: "System Error 26", type: "error", remedy: "A repair is needed if the problem persists after a restart." },
            { code: "E090", name: "Internal clock incorrect setting error", type: "error", remedy: "Set the internal clock again.\n\nIf the problem persists after a restart, a repair is needed because the built-in battery is out of power." },
            { code: "E091", name: "Internal clock access error", type: "error", remedy: "Set the internal clock again.\n\nIf the problem persists after a restart, the controller needs to be repaired because the built-in battery is out of power." },
            { code: "E092", name: "Internal memory access error", type: "error", remedy: "A repair is needed if the problem persists after a restart." },
            { code: "E100", name: "LD high-temperature error", type: "error", remedy: "Check if the controller filter is dirty or clogged.\n\nIf no problem is found with the filter, reduce the ambient temperature or install a spot cooler.\n\nIf the ambient temperature is not high, the temperature sensor is very likely defective and needs to be repaired." },
            { code: "E101", name: "LD low-temperature error", type: "error", remedy: "Please check whether the ambient temperature is within the specification range.\n\nIf the ambient temperature is not low, the temperature sensor is very likely defective and needs to be repaired." },
            { code: "E102", name: "Head unit High Temperature Error", type: "error", remedy: "Please check whether the ambient temperature is within the specification range.\n\nCheck if the controller filter is dirty or clogged, if no problem is found with the filter, reduce the ambient temperature or install a spot cooler.\n\nIf the ambient temperature is not high, the temperature sensor is very likely defective and needs to be repaired." },
            { code: "E104", name: "Qsw stop error", type: "error", remedy: "A repair is needed if the problem persists after a restart." },
            { code: "E105", name: "Q switch power error", type: "error", remedy: "A repair is needed if the problem persists after a restart." },
            { code: "E106", name: "Qsw control error", type: "error", remedy: "A repair is needed if the problem persists after a restart." },
            { code: "E107", name: "Qsw run check error", type: "error", remedy: "A repair is needed if the problem persists after a restart." },
            { code: "E110", name: "Laser power auto calibration error", type: "error", remedy: "If there is a problem with the marking quality, make adjustments by increasing the laser output.\n\nIf output is set to 100%, and marking quality issues continue even with the part in focus, a repair is needed." },
            { code: "E111", name: "Z Coordinate Correction Amount Upper Limit Error", type: "error", remedy: "If this was not intended, change the upper range limit by following the procedure below.\n\nSelect [HOME] - [Work Flow] - [Position Adjustment] in the ribbon menu, and then enter an adequate upper limit value in [Measuring Range Settings]." },
            { code: "E112", name: "Z Coordinate Correction Amount Lower Limit Error", type: "error", remedy: "If this was not intended, change the lower range limit by following the procedure below.\n\nSelect [HOME] - [Work Flow] - [Position Adjustment] in the ribbon menu, and then enter an adequate lower limit value in [Measuring Range Settings]." },
            { code: "E113", name: "Z coordinate correction measurement failure error", type: "error", remedy: "Z axis measurement may not be possible in the following cases:\n\n• Distance measuring light cannot be detected correctly because of the surface condition of the target.\n\nIn this case, use the tracking confirmation function of Marking Builder Plus to check if the stability is low.\n\nOtherwise, perform automatic adjustment of the Z tracking setting, and check that measurement is performed with highly reliable coordinates." },
            { code: "E114", name: "Current Job Error", type: "error", remedy: "Transfer the currently running job again." },
            { code: "E115", name: "Position Correction Amount Upper Limit Error", type: "error", remedy: "The result from the XY tracking movement has exceeded the tolerance limit.\n\nIf this was not intended, change the tolerance limit by following the procedure below.\n\nSelect [HOME] - [Work Flow] - [Position Adjustment] in the ribbon menu, and then enter an adequate value in the upper limit of [Measuring Range Settings]." },
            { code: "E116", name: "Position Correction Correlating Value Drop Error", type: "error", remedy: "The correlation value has fallen below the lower limit as a result of the tracking operation.\n\nCheck the target position and surface condition, or check that the lower limit of the correlation value is set appropriately." },
            { code: "E118", name: "Z Coordinate Correction Amount Stability Drop Error", type: "error", remedy: "The stability has dropped below 50 as a result of tracking.\n\nCheck the work position (measurement position) and surface condition.\n\nOtherwise, perform automatic adjustment of the Z tracking setting, and check that measurement is performed with highly reliable coordinates." },
            { code: "E119", name: "Position adjustment measurement failure error", type: "error", remedy: "Position adjustment failed. If this was not intended, change the tracking settings by following the procedure below.\n\nSelect [HOME] - [Work Flow] - [Position Adjustment] in the ribbon menu, and then edit an objective setting of XY tracing." },
            { code: "E120", name: "Position correction process fail error", type: "error", remedy: "When 'Search successful' is set as the failure condition for XY tracking, the XY tracking process will be considered a failure even when the search succeeds.\n\nIf this is not the intended result, the XY tracking settings are incorrect and must be changed." },
